{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lgy-bot-staff-dashboard",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": { "binding": "ASSETS", "directory": "dist/client", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "DashboardStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DashboardStore"] }],
  "observability": { "enabled": true }
}
